# Copy to .env and fill in. .env is never committed (RULE-SECRETS); it is read in development
# only, below the process environment (spec 1.11, D-017).

# Secrets: required outside demo mode. The app refuses to start while any is missing, malformed
# or still a <placeholder>, and names the variable, never the value (INV-8).
BOT_TOKEN=<telegram-bot-token-from-botfather>
BOT_WEBHOOK_SECRET=<1-256-chars-of-A-Za-z0-9_->
JWT_SECRET=<at-least-32-random-characters>
PII_ENCRYPTION_KEY=<base64-of-32-random-bytes>
DATABASE_URL=<postgresql://user:password@host:5432/database>

# Required outside demo mode, not secret.
OPERATOR_CHAT_ID=<telegram-chat-id-for-alerts-and-orders>
OPERATOR_TELEGRAM_IDS=<operator-telegram-user-ids-comma-separated>

# APP_ENV (development, test, production, demo; unset means development) is read from the
# process environment only, never from this file (D-017).

# Plain settings: optional, defaults shown.
LOG_FORMAT=console
LOG_LEVEL=Information
SERVE_HOST=127.0.0.1
ALERT_COOLDOWN_SECONDS=300
RATE_ALERT_COOLDOWN_SECONDS=900
RATE_FETCH_TIMEOUT_SECONDS=10
ECB_RATES_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
ECB_RATE_CACHE_SECONDS=3600
ECB_RATE_MAX_AGE_SECONDS=129600
ECB_RATE_MAX_EFFECTIVE_AGE_DAYS=5
CBR_RATES_URL=https://www.cbr.ru/scripts/XML_daily.asp
CBR_RATE_CACHE_SECONDS=3600
CBR_RATE_MAX_AGE_SECONDS=129600
CBR_RATE_MAX_EFFECTIVE_LEAD_DAYS=1
CBR_RATE_MAX_EFFECTIVE_AGE_DAYS=15
RUB_WIRE_ORDER_MIN=10000
RUB_WIRE_ORDER_MAX=1000000
USD_CASH_ORDER_MIN=100
USD_CASH_ORDER_MAX=10000
EUR_CASH_ORDER_MIN=100
EUR_CASH_ORDER_MAX=10000
USDT_ORDER_MIN=100
USDT_ORDER_MAX=10000
INIT_DATA_MAX_AGE_SECONDS=86400
JWT_TTL_SECONDS=3600
